            }
          }
        },
        {
          "event": "capability_provider_response",
          "correlation_id": "c-b8",
          "payload": {
            "json": {
              "error": "$nonempty"
            }
          }
        }
      ]
    },
    {
      "expect_none": {
        "for_ms": 1000
      }
    }
  ]
}
