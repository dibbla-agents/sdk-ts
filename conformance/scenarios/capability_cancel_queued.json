            }
          }
        },
        {
          "event": "capability_provider_response",
          "correlation_id": "c-b3",
          "payload": {
            "json": {
              "error": "$nonempty"
            }
          }
        },
        {
          "event": "capability_provider_response",
          "correlation_id": "c-b4",
          "payload": {
