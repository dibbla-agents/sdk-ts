{
  "name": "@dibbla-agents/sdk-ts",
  "version": "0.0.1",
  "description": "Dibbla Agents SDK for TypeScript - Build workflow functions with gRPC communication",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src/proto"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "conformance": "CONFORMANCE_WORKER=ts node --import tsx --test conformance/conformance.test.ts",
    "conformance:go": "CONFORMANCE_WORKER=go node --import tsx --test conformance/conformance.test.ts"
  },
  "keywords": [
    "dibbla",
    "agents",
    "workflow",
    "grpc",
    "sdk"
  ],
  "author": "Dibbla",
  "license": "MIT",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.7.0",
    "dotenv": "^16.3.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
