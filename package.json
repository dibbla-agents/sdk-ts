{
  "name": "@dibbla/sdk-ts",
  "version": "0.1.0",
  "description": "Dibbla Agents SDK for TypeScript: workers that serve functions, jobs and capability providers to the Dibbla workflow engine",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "conformance": "CONFORMANCE_WORKER=ts node --import tsx --test conformance/conformance.test.ts",
    "conformance:packed": "CONFORMANCE_TS_SDK=packed-cjs npm run conformance && CONFORMANCE_TS_SDK=packed-esm npm run conformance",
    "conformance:go": "CONFORMANCE_WORKER=go node --import tsx --test conformance/conformance.test.ts"
  },
  "keywords": [
    "dibbla",
    "agents",
    "workflow",
    "grpc",
    "sdk"
  ],
  "author": "Dibbla",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dibbla-agents/sdk-ts.git"
  },
  "homepage": "https://github.com/dibbla-agents/sdk-ts#readme",
  "bugs": {
    "url": "https://github.com/dibbla-agents/sdk-ts/issues"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.7.0",
    "dotenv": "^16.3.0",
    "protobufjs": "^7.2.5",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
